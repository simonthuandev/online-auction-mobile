# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG CHO EXPO MOBILE APP (SDK 58)
# ==============================================================================
# Lưu ý: Các biến môi trường trong Expo client bắt đầu bằng prefix "EXPO_PUBLIC_"
#
# 1. Chạy trên iOS Simulator (chạy cùng máy với Backend):
#    EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
#    EXPO_PUBLIC_SOCKET_AUCTION_URL=http://localhost:3003/auctions
#    EXPO_PUBLIC_SOCKET_NOTIF_URL=http://localhost:3006/notifications
#
# 2. Chạy trên Android Emulator (Android sử dụng 10.0.2.2 để trỏ về host localhost):
#    EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
#    EXPO_PUBLIC_SOCKET_AUCTION_URL=http://10.0.2.2:3003/auctions
#    EXPO_PUBLIC_SOCKET_NOTIF_URL=http://10.0.2.2:3006/notifications
#
# 3. Chạy trên Thiết bị thật (Expo Go / Development Build qua mạng LAN Wi-Fi):
#    (Thay 192.168.1.xxx bằng địa chỉ IP LAN máy chạy Backend, dùng `ip a` hoặc `ifconfig`)
#    EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8080
#    EXPO_PUBLIC_SOCKET_AUCTION_URL=http://192.168.1.100:3003/auctions
#    EXPO_PUBLIC_SOCKET_NOTIF_URL=http://192.168.1.100:3006/notifications
# ==============================================================================

# Cấu hình mặc định (Android Emulator):
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
EXPO_PUBLIC_SOCKET_AUCTION_URL=http://10.0.2.2:3003/auctions
EXPO_PUBLIC_SOCKET_NOTIF_URL=http://10.0.2.2:3006/notifications

# Flag tính năng bổ sung (VNPay checkpoint D9)
EXPO_PUBLIC_ENABLE_VNPAY=false
